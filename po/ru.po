#: cheeselooks/themes.py:180 cheeselooks/themes.py:200
#, python-brace-format
msgid "a theme's name can be up to {count} characters ({given} given)"
msgstr "имя темы может быть длиной до {count} символов (сейчас {given})"

#: cheeselooks/themes.py:184
#, python-brace-format
msgid "“{theme}” is a built-in theme: choose another name"
msgstr "«{theme}» — встроенная тема: выберите другое имя"

#: cheeselooks/themes.py:186
#, python-brace-format
msgid "you already have a theme called “{theme}”"
msgstr "у вас уже есть тема «{theme}»"

#: cheeselooks/themes.py:203
#, python-brace-format
msgid "there's already a theme called “{theme}”"
msgstr "тема «{theme}» уже есть"

#: cheeselooks/themes.py:215
msgid "couldn't find a free name for the copy"
msgstr "не удалось подобрать свободное имя для копии"

#: cheeselooks/themes.py:230
msgid "built-in themes can't be renamed: duplicate it instead"
msgstr "встроенные темы нельзя переименовать: продублируйте её"

#: cheeselooks/themes.py:250
msgid "built-in themes can't be deleted"
msgstr "встроенные темы нельзя удалить"

#: cheeselooks/themes.py:285
#, python-brace-format
msgid "{file} isn't a Theme Roller theme file"
msgstr "{file} — не файл темы Theme Roller"

#: cheeselooks/themes.py:288
#, python-brace-format
msgid ""
"This theme was made with a newer Theme Roller ({version}). Some of it may not show as intended; updating Theme Roller is recommended."
msgstr ""
"Эта тема сделана в более новом Theme Roller ({version}). Часть её может выглядеть не так, как задумано; рекомендуется обновить Theme Roller."

#: cheeselooks/themes.py:295
#, python-brace-format
msgid ""
"You already have a style folder “{folder}”: kept yours, so the theme uses your copy of that style."
msgstr ""
"У вас уже есть папка стиля «{folder}»: оставлена ваша, так что тема использует вашу копию этого стиля."

#: cheeselooks/themes.py:302
msgid "the theme file contains an unsafe path"
msgstr "файл темы содержит небезопасный путь"

#: cheeselooks/themes.py:308
#, python-brace-format
msgid ""
"The theme's name was longer than {count} characters: shortened to “{theme}”."
msgstr "Имя темы было длиннее {count} символов: сокращено до «{theme}»."

#: cheeselooks/themes.py:318
#, python-brace-format
msgid "A theme called “{theme}” already exists: imported as “{copy}”."
msgstr "Тема «{theme}» уже есть: импортирована как «{copy}»."

